# 第一阶段：构建Vue前端
FROM node:18 AS web-builder
WORKDIR /app
COPY main/manager-web/package*.json ./
RUN npm install
COPY main/manager-web .
ENV VUE_APP_API_BASE_URL=/xiaozhi VUE_APP_H5_URL=/mobile/
RUN npm run build

# 移动 H5 与 Web 共用站点及 /xiaozhi API，复用同一 IDONE 回调。
FROM node:22-bookworm-slim AS mobile-builder
WORKDIR /app
RUN npm install -g pnpm@10.10.0 --registry=https://registry.npmjs.org
COPY main/manager-mobile/package.json main/manager-mobile/pnpm-lock.yaml main/manager-mobile/pnpm-workspace.yaml main/manager-mobile/.npmrc ./
COPY main/manager-mobile/patches ./patches
RUN pnpm install --frozen-lockfile --ignore-scripts --registry=https://registry.npmjs.org
COPY main/manager-mobile .
ENV VITE_APP_TITLE=小智 VITE_APP_PUBLIC_BASE=/mobile/ VITE_APP_PORT=9000 \
    VITE_LOGIN_URL=/pages/login/index VITE_SERVER_BASEURL=/xiaozhi \
    VITE_APP_PROXY=false VITE_APP_PROXY_PREFIX=/xiaozhi VITE_UPLOAD_BASEURL=/otaMag/upload \
    VITE_DELETE_CONSOLE=true VITE_FALLBACK_LOCALE=zh-Hans
RUN pnpm build:h5

# 第二阶段：构建Java后端
FROM maven:3.9.4-eclipse-temurin-21 AS api-builder
WORKDIR /app
COPY main/manager-api/pom.xml .
COPY main/manager-api/src ./src
RUN mvn clean package -Dmaven.test.skip=true

# 第三阶段：构建最终镜像
FROM bellsoft/liberica-runtime-container:jre-21-glibc

# 安装Nginx和字体库
RUN apk update && \
    apk add --no-cache --no-scripts \
        nginx \
        bash \
        fontconfig \
        ttf-dejavu \
    && rm -rf /var/cache/apk/* \
    && mkdir -p /run/nginx /var/log/nginx /var/tmp/nginx /etc/nginx/conf.d

# 复制项目自带的中文字体
COPY main/manager-web/public/generator/static/fonts/*.ttf /usr/share/fonts/

# 更新字体缓存
RUN fc-cache -f -v

# 配置Nginx
COPY docs/docker/nginx.conf /etc/nginx/nginx.conf

# 复制前端构建产物
COPY --from=web-builder /app/dist /usr/share/nginx/html
COPY --from=mobile-builder /app/dist/build/h5 /usr/share/nginx/html/mobile

# 复制Java后端JAR包
COPY --from=api-builder /app/target/xiaozhi-esp32-api.jar /app/xiaozhi-esp32-api.jar

# 暴露端口
EXPOSE 8002

# 启动脚本
COPY docs/docker/start.sh /start.sh
RUN chmod +x /start.sh
CMD ["/start.sh"]
