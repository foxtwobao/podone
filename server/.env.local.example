MYSQL_ROOT_PASSWORD=replace-with-database-password
XIAOZHI_BIND_IP=127.0.0.1

# 浏览器访问地址，不带尾斜杠。通过同一域名代理 /xiaozhi/ 到管理端。
APP_ORIGIN=https://xiaozhi.example.com
IDONE_ISSUER=https://idone.lab.home.arpa
# 使用本项目独立应用的 Discovery，按实际注册的应用填写。
IDONE_DISCOVERY_URL=https://idone.lab.home.arpa/.well-known/xiaozhi/openid-configuration
IDONE_CLIENT_ID=replace-with-idone-client-id
IDONE_CLIENT_SECRET=replace-with-idone-client-secret
